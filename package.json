{
  "name": "@tirth1107/hyde-security-js",
  "version": "2.0.0",
  "description": "Modern client-side security layer for web apps: supply-chain script guard (PCI DSS 6.4.3/11.6.1), skimmer & ClickFix defense, AI-agent prompt-injection shield, network firewall, Trusted Types, passkeys, Web Crypto encryption, security audit, and more.",
  "main": "dist/hyde-security-js.cjs.js",
  "module": "dist/hyde-security-js.esm.mjs",
  "unpkg": "dist/hyde-security-js.umd.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/hyde-security-js.esm.mjs",
      "require": "./dist/hyde-security-js.cjs.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.esm.mjs",
      "require": "./dist/react.cjs.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && vite build --mode umd && tsc --emitDeclarationOnly",
    "build:website": "npm --prefix website run build",
    "dev": "vite",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "prepublishOnly": "npm run build",
    "clean": "rimraf dist",
    "test:browser": "node tests/browser/smoke.mjs"
  },
  "keywords": [
    "security",
    "client-side",
    "xss",
    "anti-devtools",
    "anti-debug",
    "encryption",
    "session",
    "fingerprint",
    "bot-detection",
    "dom-protection",
    "sanitize",
    "tamper-detection",
    "hyde",
    "web-security",
    "content-protection",
    "pci-dss",
    "magecart",
    "formjacking",
    "clickfix",
    "prompt-injection",
    "ai-agents",
    "trusted-types",
    "passkeys",
    "webauthn",
    "supply-chain",
    "csp"
  ],
  "author": "HydeSecurityJS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tirth1107/Hyde-Security-JS.git"
  },
  "homepage": "https://github.com/Tirth1107/Hyde-Security-JS#readme",
  "bugs": {
    "url": "https://github.com/Tirth1107/Hyde-Security-JS/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@fingerprintjs/fingerprintjs": "^4.0.0",
    "axios": "^1.4.0",
    "bowser": "^2.11.0",
    "crypto-js": "^4.1.1",
    "devtools-detector": "^2.0.25",
    "dompurify": "^3.4.17",
    "js-cookie": "^3.0.1",
    "localforage": "^1.10.0",
    "lodash.throttle": "^4.1.1",
    "validator": "^13.9.0",
    "zxcvbn": "^4.4.2"
  },
  "peerDependencies": {
    "react": ">=16.8.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/crypto-js": "^4.1.1",
    "@types/js-cookie": "^3.0.2",
    "@types/lodash.throttle": "^4.1.6",
    "@types/node": "^20.4.2",
    "@types/react": "^18.2.0",
    "@types/validator": "^13.7.0",
    "@types/zxcvbn": "^4.4.5",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/ui": "^1.1.0",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "jsdom": "^23.0.1",
    "puppeteer-core": "^24.43.1",
    "react": "^18.2.0",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.0.8",
    "vitest": "^1.1.0"
  }
}
